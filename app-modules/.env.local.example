# ═══════════════════════════════════════════════════════════════════
# AKILI ERP — Variables d'environnement
#
# Copier en « .env.local » puis remplir. Ne jamais versionner .env.local.
# Sur Vercel : Settings → Environment Variables (mêmes noms).
# ═══════════════════════════════════════════════════════════════════

# ── Supabase ────────────────────────────────────────────────────────
# app.supabase.com → ton projet → Settings → API
#
# Le préfixe NEXT_PUBLIC_ rend ces valeurs visibles dans le navigateur.
# C'est voulu et sans risque pour la clé « anon » : elle n'ouvre aucun
# droit par elle-même, ce sont les politiques RLS qui protègent.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Secrets — jamais de préfixe NEXT_PUBLIC_ ────────────────────────
# La clé service_role contourne RLS : avec le préfixe, n'importe quel
# visiteur lirait et modifierait toutes les données de tous tes clients.
SUPABASE_SERVICE_ROLE_KEY=

# La clé Claude est un vrai secret. Avec le préfixe, un visiteur la lit
# dans le code de la page et consomme ton crédit Anthropic.
# À lire uniquement depuis une route serveur (app/api/chat/route.js).
ANTHROPIC_API_KEY=
