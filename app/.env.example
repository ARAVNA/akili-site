# AKILI ERP — à copier en « .env » (ou à saisir dans Vercel/Netlify)
#
# app.supabase.com → ton projet → Settings → API
# La clé « anon » est visible dans le navigateur : c'est normal, elle
# n'ouvre aucun droit. Ce sont les politiques RLS qui protègent.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Serveur uniquement — JAMAIS de préfixe VITE_ ────────────────────
# Avec le préfixe, ces clés partiraient dans le navigateur et
# n'importe quel visiteur pourrait les lire.
#
# Clé Anthropic : console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Modèle utilisé (facultatif)
ANTHROPIC_MODEL=
# Clé service_role Supabase : Settings → API → service_role
# Elle contourne les règles RLS : à ne jamais exposer.
SUPABASE_SERVICE_ROLE_KEY=
